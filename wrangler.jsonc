{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maelstrom",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "maelstrom.mokhan.ca", "zone_name": "mokhan.ca", "custom_domain": true }
  ]
}
